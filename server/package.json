{
  "name": "eth-alpha-v1.4b-feature-foundation",
  "version": "1.4.0-b.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "test": "node --test tests/*.test.js tests/forecast/*.test.js",
    "test:live": "node --test tests/live/*.test.js",
    "test:postgres": "npm run test:postgres:v1.4a && npm run test:postgres:features && npm run test:postgres:revision && npm run test:postgres:v1.4c-forecast && npm run test:postgres:v1.4c-outcome && npm run test:postgres:v1.4c-lease && npm run test:postgres:v1.4c-lifecycle",
    "test:postgres:v1.4a": "node --test tests/postgres/postgres-production.integration.test.js",
    "test:postgres:live": "node --test tests/live/postgres-live-e2e.test.js",
    "test:features": "node --test tests/features/*.test.js",
    "test:postgres:features": "node --test tests/postgres/v1-4b-feature.integration.test.js",
    "test:postgres:revision": "node --test tests/postgres/v1-4b-revision-time-progression.integration.test.js",
    "test:forecast": "node --test tests/forecast/*.test.js",
    "test:postgres:v1.4c-forecast": "node --test tests/postgres/v1-4c-forecast.integration.test.js",
    "test:postgres:v1.4c-outcome": "node --test tests/postgres/v1-4c-outcome.integration.test.js",
    "test:postgres:v1.4c-lease": "node --test tests/postgres/v1-4c-lease-concurrency.integration.test.js",
    "test:postgres:v1.4c-lifecycle": "node --test tests/postgres/v1-4c-lifecycle.integration.test.js",
    "maintenance:health": "node src/maintenance/cleanup-health.js",
    "features:generate": "node src/features/generate-features.js",
    "features:backfill-historical": "node src/features/historical-feature-backfill-cli.js",
    "features:serve": "node src/features/generator-service-entry.js",
    "backfill:market-bars": "node src/backfill/backfill-cli-entry.js",
    "dataset:build-manifest": "node src/validation-replay/dataset-manifest-cli-entry.js",
    "dataset:inventory-manifests": "node scripts/v1-4d-manifest-inventory.mjs",
    "test:postgres:v1.4d-multi-symbol": "node --test tests/postgres/v1-4d-multi-symbol-manifest.integration.test.js",
    "validation:walk-forward": "node src/validation-replay/cli-entry.js",
    "verify:v1.4d": "node scripts/verify-v1-4d.mjs",
    "scorecard:v1.4d": "node scripts/v1-4d-scorecard-cli.mjs",
    "test:r3-batch1": "node --test src/formal-research/*.test.js src/validation-replay/formal-run-config.test.js",
    "test:r3-batch2": "node --test src/formal-research/go-no-go-evaluator.test.js",
    "test:postgres:r3-batch3": "node --test tests/postgres/v1-4d-formal-research-data-repository.integration.test.js",
    "test:postgres:r3-batch4": "node --test tests/postgres/v1-4d-formal-research-data-repository.integration.test.js",
    "test:verification-bundle": "node --test src/validation-replay/research-scorecard.test.js scripts/v1-4d-scorecard-cli.test.mjs",
    "check": "node --check src/index.js && node --test tests/*.test.js tests/forecast/*.test.js"
  },
  "dependencies": { "ajv": "8.20.0", "canonicalize": "3.0.0", "pg": "^8.16.3" }
}
