          "required": [
            "expected",
            "attempted",
            "inserted",
            "reusedIdentical",
            "conflicts",
            "blocked",
            "evaluated"
          ],
          "type": "object"
        },
        "manifestContentHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "manifestCoverage": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "schemaVersion": {
          "const": "v1.4d-audit-trail/1"
        },
        "validationRunId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "validationRunStatus": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "RUNNING"
          ]
        },
        "vintageIds": {
          "items": {
