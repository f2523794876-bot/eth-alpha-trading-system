[Unit]
Description=ETH Alpha V1.4A public market data collector
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=eth-alpha
Group=eth-alpha
WorkingDirectory=/opt/eth-alpha/eth-alpha-trading-system/server
EnvironmentFile=/etc/eth-alpha/collector.env
ExecStart=/usr/bin/node /opt/eth-alpha/eth-alpha-trading-system/server/src/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/eth-alpha
UMask=0077

[Install]
WantedBy=multi-user.target
